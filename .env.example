# Transform - File Converter Configuration
# Copy this file to .env and fill in your values

# Environment: development | production
# In production the app refuses to boot with a weak SECRET_KEY, wildcard CORS,
# or plaintext object storage.
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Run database migrations at app startup (default true). Set false when
# migrations are applied by a separate one-shot step in the deployment.
RUN_MIGRATIONS=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://transform:transform_secret@postgres:5432/transform

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=86400

# Object Storage (S3-compatible: Minio, Backblaze B2, AWS S3)
# Host[:port] without a scheme — the scheme comes from BACKBLAZE_USE_SSL.
# (http://minio:9000 is also accepted and normalized automatically.)
BACKBLAZE_ENDPOINT=minio:9000
BACKBLAZE_ACCESS_KEY=minioadmin
BACKBLAZE_SECRET_KEY=minioadmin
S3_BUCKET_NAME=transform-convertion-bucket
BASE_TARGET_KEY=output/
UPLOAD_URL_TTL_MINUTES=15
# Set to true when using HTTPS endpoints (AWS S3, Backblaze B2). Required in production.
BACKBLAZE_USE_SSL=false

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# When set, files are encrypted at rest (AES-256-GCM): the worker stores only
# ciphertext in object storage and downloads are decrypted through the API.
# Leave empty to store plaintext.
ENCRYPTION_MASTER_KEY=

# Stripe (optional - for paid subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs for subscription checkout
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_PRO_PLUS=price_pro_plus_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
# Redirect URLs used by Stripe-hosted Checkout + Customer Portal.
#
# These must point at the SPA, which is hosted separately from the API. Locally
# that is the Vite dev server (5173). In production it is the static site, e.g.
#   STRIPE_SUCCESS_URL=https://transform-web.onrender.com/app/billing?checkout=success
#   STRIPE_CANCEL_URL=https://transform-web.onrender.com/app/billing?checkout=cancelled
#   STRIPE_CREDIT_SUCCESS_URL=https://transform-web.onrender.com/app/billing?credits=success
#   STRIPE_CREDIT_CANCEL_URL=https://transform-web.onrender.com/app/billing?credits=cancelled
#   STRIPE_PORTAL_RETURN_URL=https://transform-web.onrender.com/app/billing
# Subscription checkout
STRIPE_SUCCESS_URL=http://localhost:5173/app/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/app/billing?checkout=cancelled
# Credit-pack checkout
STRIPE_CREDIT_SUCCESS_URL=http://localhost:5173/app/billing?credits=success
STRIPE_CREDIT_CANCEL_URL=http://localhost:5173/app/billing?credits=cancelled
# Customer Portal return URL
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/app/billing

# Rate Limiting (requests per minute)
RATE_LIMIT_GUEST=10
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=100
RATE_LIMIT_PRO_PLUS=200
RATE_LIMIT_ENTERPRISE=500
RATE_LIMIT_API_KEY_DEFAULT=1000
RATE_LIMIT_AUTH=10
# Authenticated (JWT) users — higher than the IP-based free limit so the SPA
# can make many API calls without being throttled.
RATE_LIMIT_AUTHENTICATED=600

# CORS — the React SPA is built and hosted *separately* from the API (Render
# static site `transform-web`) and calls this API cross-origin. List every origin
# that may call the API: the Vite dev server + API origin for local development,
# and the deployed static site origin in production.
# Wildcard ("*") is refused at boot in production.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","https://transform-web.onrender.com"]

# S3/Backblaze bucket CORS origins — the browser uploads files directly to
# object storage (presigned PUT), so the bucket must allow these origins.
# Must include the SPA origin in every environment: the bucket holds ONE shared
# rule set and each environment rewrites it on startup, so a local dev process
# listing only localhost would drop the deployed SPA's origin and break uploads.
# `ALWAYS_ALLOWED_ORIGINS` in src/infrastructure/adapters/storage/cors.py pins
# the known app origins, so listing them here is belt-and-braces.
# Verify the live policy with: python -m
# src.infrastructure.adapters.storage.cors --check
S3_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8000","https://transform-web.onrender.com"]

# Monitoring (optional)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Transactional email + sign-up email verification
# ---------------------------------------------------------------------------
# Sign-up sends a verification link, and an unverified account cannot sign in
# (403 EMAIL_NOT_VERIFIED). Verification is only ENFORCED when a real transport
# is configured — see EMAIL_BACKEND below — so an unconfigured deployment keeps
# working exactly as before instead of locking every new signup out of an inbox
# that can never receive the link. The API logs an ERROR at boot in that state.

# auto | console | smtp | resend
#   auto    (default) Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is
#           set, else console.
#   resend  Resend HTTP API (requires RESEND_API_KEY).
#   smtp    Any SMTP relay (requires SMTP_HOST) — SendGrid, Postmark, Mailgun,
#           Amazon SES, Google Workspace.
#   console Logs the email instead of sending it. Development only.
# Naming a transport whose credentials are missing is a startup error; `auto`
# never is.
EMAIL_BACKEND=auto

# Envelope sender. The address must be on a domain you have verified with your
# provider, or the send is rejected and/or lands in spam.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Transform
# Optional monitored Reply-To. Leave unset rather than pointing it at a
# mailbox nobody reads.
EMAIL_REPLY_TO=

# --- Resend (EMAIL_BACKEND=resend, or auto + RESEND_API_KEY) ---
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# --- SMTP (EMAIL_BACKEND=smtp, or auto + SMTP_HOST) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS upgrades a plaintext connection (port 587). Implicit TLS (port 465)
# uses SMTP_USE_SSL instead. Enabling both is a startup error.
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Public origin of the SPA, used to build the link in the verification email.
# MUST NOT have a trailing slash and must be the publicly reachable origin —
# an http://localhost value sends links only the developer's machine can open.
#   production:  APP_BASE_URL=https://transform-web.onrender.com
APP_BASE_URL=http://localhost:5173

# How long a verification link stays valid.
EMAIL_VERIFICATION_TTL_HOURS=24
# Minimum seconds between two verification emails for one account. Prevents the
# resend endpoint from being used as a mail-bomb against a third party's inbox.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Master switch. false lets unverified accounts sign in (verification becomes
# advisory). The operational escape hatch if email delivery breaks.
EMAIL_VERIFICATION_REQUIRED=true

# Worker Configuration
WORKER_CONSUMER_GROUP=conversion-workers
WORKER_BATCH_SIZE=10
WORKER_CONVERSION_TIMEOUT=600

# Cleanup Worker (guest data retention)
CLEANUP_INTERVAL_SECONDS=21600
GUEST_JOB_RETENTION_HOURS=24
GUEST_FILE_RETENTION_HOURS=24
TEMP_FILE_RETENTION_HOURS=1
JOB_ARCHIVE_AFTER_DAYS=30
