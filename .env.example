# Transform - File Converter Configuration
# Copy this file to .env and fill in your values

# Environment: development | production
# In production the app refuses to boot with a weak SECRET_KEY, wildcard CORS,
# or plaintext object storage.
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Run database migrations at app startup (default true). Set false when
# migrations are applied by a separate one-shot step in the deployment.
RUN_MIGRATIONS=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://transform:transform_secret@postgres:5432/transform

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=86400

# Object Storage (S3-compatible: Minio, Backblaze B2, AWS S3)
# Host[:port] without a scheme — the scheme comes from BACKBLAZE_USE_SSL.
# (http://minio:9000 is also accepted and normalized automatically.)
BACKBLAZE_ENDPOINT=minio:9000
BACKBLAZE_ACCESS_KEY=minioadmin
BACKBLAZE_SECRET_KEY=minioadmin
S3_BUCKET_NAME=transform-convertion-bucket
BASE_TARGET_KEY=output/
UPLOAD_URL_TTL_MINUTES=15
# Set to true when using HTTPS endpoints (AWS S3, Backblaze B2). Required in production.
BACKBLAZE_USE_SSL=false

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# When set, files are encrypted at rest (AES-256-GCM): the worker stores only
# ciphertext in object storage and downloads are decrypted through the API.
# Leave empty to store plaintext.
ENCRYPTION_MASTER_KEY=

# Stripe (optional - for paid subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs for subscription checkout
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_PRO_PLUS=price_pro_plus_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Rate Limiting (requests per minute)
RATE_LIMIT_GUEST=10
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=100
RATE_LIMIT_PRO_PLUS=200
RATE_LIMIT_ENTERPRISE=500
RATE_LIMIT_API_KEY_DEFAULT=1000
RATE_LIMIT_AUTH=10

# CORS — in production list explicit origins, e.g. ["https://app.example.com"].
# Wildcard ("*") is refused at boot in production.
ALLOWED_ORIGINS=["*"]

# Monitoring (optional)
SENTRY_DSN=

# Worker Configuration
WORKER_CONSUMER_GROUP=conversion-workers
WORKER_BATCH_SIZE=10
WORKER_CONVERSION_TIMEOUT=600

# Cleanup Worker (guest data retention)
CLEANUP_INTERVAL_SECONDS=21600
GUEST_JOB_RETENTION_HOURS=24
GUEST_FILE_RETENTION_HOURS=24
TEMP_FILE_RETENTION_HOURS=1
JOB_ARCHIVE_AFTER_DAYS=30
