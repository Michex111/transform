# Transform - File Converter Configuration
# Copy this file to .env and fill in your values

# Environment: development | production
# In production the app refuses to boot with a weak SECRET_KEY, wildcard CORS,
# or plaintext object storage.
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Run database migrations at app startup (default true). Set false when
# migrations are applied by a separate one-shot step in the deployment.
RUN_MIGRATIONS=true

# Largest request body the API accepts, in bytes. The API only receives JSON
# metadata (uploads go straight to object storage via presigned URLs, never
# through this process), so the real bodies are tiny — the largest legitimate
# one is a multipart-finalise part list (~1.5 MB). 4 MiB leaves headroom while
# refusing the unbounded body a hostile client would otherwise make the server
# buffer in memory. Rejected on the declared Content-Length, before reading.
MAX_REQUEST_BODY_BYTES=4194304

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://transform:transform_secret@postgres:5432/transform

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=86400

# Object Storage (S3-compatible: Minio, Backblaze B2, AWS S3)
# Host[:port] without a scheme — the scheme comes from BACKBLAZE_USE_SSL.
# (http://minio:9000 is also accepted and normalized automatically.)
BACKBLAZE_ENDPOINT=minio:9000
BACKBLAZE_ACCESS_KEY=minioadmin
BACKBLAZE_SECRET_KEY=minioadmin
S3_BUCKET_NAME=transform-convertion-bucket
BASE_TARGET_KEY=output/
# TTL (minutes) of the single-PUT presigned upload URL, and of small upload
# sessions. Keep it short: a leaked URL is a write primitive.
UPLOAD_URL_TTL_MINUTES=15
# TTL (minutes) for multipart sessions and their part URLs. Uploads at/above
# MULTIPART_THRESHOLD_BYTES use this instead: a 5 GiB transfer outlives a
# 15-minute window on ordinary connections, and an expired URL mid-transfer
# looks like a network fault to the user.
LARGE_UPLOAD_URL_TTL_MINUTES=120
# Set to true when using HTTPS endpoints (AWS S3, Backblaze B2). Required in production.
BACKBLAZE_USE_SSL=false

# ---------------------------------------------------------------------------
# Upload size limits (bytes)
# ---------------------------------------------------------------------------
# Two INDEPENDENT controls:
#   * *_MAX_FILE_SIZE     = how large ONE file may be (per-file cap).
#   * TierPolicy quota    = how much an account may hold IN TOTAL (storage
#                           quota; see domain/subscriptions/policies).
# A FREE account has a 5 GiB quota and a 5 GiB cap, so it can upload one 5 GiB
# file and then nothing more — the intended behaviour, not a bug.
#
# The single authoritative ceiling for one authenticated upload. No per-tier
# cap may exceed it (the app refuses to start if one does).
MAX_UPLOAD_FILE_SIZE_BYTES=5368709120
# Guests are unauthenticated and unattributed, so their ceiling stays small on
# purpose — a 5 GiB guest ceiling would be a free anonymous storage sink.
GUEST_MAX_FILE_SIZE=52428800
# Per-tier per-file caps for authenticated uploads.
FREE_MAX_FILE_SIZE=5368709120
PRO_MAX_FILE_SIZE=5368709120
PRO_PLUS_MAX_FILE_SIZE=5368709120
ENTERPRISE_MAX_FILE_SIZE=5368709120
# Declared size at/above which an upload switches to S3 multipart (presigned
# part URLs). Below it the session keeps the simple single-PUT URL.
MULTIPART_THRESHOLD_BYTES=104857600
# Size of each multipart part. Must be large enough that the ceiling needs fewer
# than S3's 10000-part limit (validated at startup); 64 MiB gives 80 parts for
# a 5 GiB file.
MULTIPART_PART_SIZE_BYTES=67108864

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# When set, files are encrypted at rest (AES-256-GCM): the worker stores only
# ciphertext in object storage and downloads are decrypted through the API.
# Leave empty to store plaintext.
ENCRYPTION_MASTER_KEY=

# Stripe (optional - for paid subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs for subscription checkout
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_PRO_PLUS=price_pro_plus_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly
# Redirect URLs used by Stripe-hosted Checkout + Customer Portal.
#
# These must point at the SPA, which is hosted separately from the API. Locally
# that is the Vite dev server (5173). In production it is the static site, e.g.
#   STRIPE_SUCCESS_URL=https://transform-web.onrender.com/app/billing?checkout=success
#   STRIPE_CANCEL_URL=https://transform-web.onrender.com/app/billing?checkout=cancelled
#   STRIPE_CREDIT_SUCCESS_URL=https://transform-web.onrender.com/app/billing?credits=success
#   STRIPE_CREDIT_CANCEL_URL=https://transform-web.onrender.com/app/billing?credits=cancelled
#   STRIPE_PORTAL_RETURN_URL=https://transform-web.onrender.com/app/billing
# Subscription checkout
STRIPE_SUCCESS_URL=http://localhost:5173/app/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/app/billing?checkout=cancelled
# Credit-pack checkout
STRIPE_CREDIT_SUCCESS_URL=http://localhost:5173/app/billing?credits=success
STRIPE_CREDIT_CANCEL_URL=http://localhost:5173/app/billing?credits=cancelled
# Customer Portal return URL
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/app/billing

# Rate Limiting (requests per minute)
RATE_LIMIT_GUEST=10
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=100
RATE_LIMIT_PRO_PLUS=200
RATE_LIMIT_ENTERPRISE=500
RATE_LIMIT_API_KEY_DEFAULT=1000
RATE_LIMIT_AUTH=10
# Authenticated (JWT) users — higher than the IP-based free limit so the SPA
# can make many API calls without being throttled.
RATE_LIMIT_AUTHENTICATED=600

# CORS — the React SPA is built and hosted *separately* from the API (Render
# static site `transform-web`) and calls this API cross-origin. List every origin
# that may call the API: the Vite dev server + API origin for local development,
# and the deployed static site origin in production.
# Wildcard ("*") is refused at boot in production.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","https://transform-web.onrender.com"]

# S3/Backblaze bucket CORS origins — the browser uploads files directly to
# object storage (presigned PUT), so the bucket must allow these origins.
# Must include the SPA origin in every environment: the bucket holds ONE shared
# rule set and each environment rewrites it on startup, so a local dev process
# listing only localhost would drop the deployed SPA's origin and break uploads.
# `ALWAYS_ALLOWED_ORIGINS` in src/infrastructure/adapters/storage/cors.py pins
# the known app origins, so listing them here is belt-and-braces.
# Verify the live policy with: python -m
# src.infrastructure.adapters.storage.cors --check
S3_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8000","https://transform-web.onrender.com"]

# Monitoring (optional)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Transactional email + sign-up email verification
# ---------------------------------------------------------------------------
# Sign-up sends a verification link, and an unverified account cannot sign in
# (403 EMAIL_NOT_VERIFIED). Verification is only ENFORCED when a real transport
# is configured — see EMAIL_BACKEND below — so an unconfigured deployment keeps
# working exactly as before instead of locking every new signup out of an inbox
# that can never receive the link. The API logs an ERROR at boot in that state.

# auto | console | smtp | resend
#   auto    (default) Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is
#           set, else console.
#   resend  Resend HTTP API (requires RESEND_API_KEY).
#   smtp    Any SMTP relay (requires SMTP_HOST) — SendGrid, Postmark, Mailgun,
#           Amazon SES, Google Workspace.
#   console Logs the email instead of sending it. Development only.
# Naming a transport whose credentials are missing is a startup error; `auto`
# never is.
EMAIL_BACKEND=auto

# Envelope sender. The address must be on a domain you have verified with your
# provider, or the send is rejected and/or lands in spam.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Transform
# Optional monitored Reply-To. Leave unset rather than pointing it at a
# mailbox nobody reads.
EMAIL_REPLY_TO=

# --- Resend (EMAIL_BACKEND=resend, or auto + RESEND_API_KEY) ---
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# --- SMTP (EMAIL_BACKEND=smtp, or auto + SMTP_HOST) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS upgrades a plaintext connection (port 587). Implicit TLS (port 465)
# uses SMTP_USE_SSL instead. Enabling both is a startup error.
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Public origin of the SPA, used to build the link in the verification email.
# MUST NOT have a trailing slash and must be the publicly reachable origin —
# an http://localhost value sends links only the developer's machine can open.
#   production:  APP_BASE_URL=https://transform-web.onrender.com
APP_BASE_URL=http://localhost:5173

# How long a verification link stays valid.
EMAIL_VERIFICATION_TTL_HOURS=24
# Minimum seconds between two verification emails for one account. Prevents the
# resend endpoint from being used as a mail-bomb against a third party's inbox.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Master switch. false lets unverified accounts sign in (verification becomes
# advisory). The operational escape hatch if email delivery breaks.
EMAIL_VERIFICATION_REQUIRED=true

# Password reset (the "Forgot password?" flow on the sign-in page). It reuses
# the same email transport as verification — there is nothing else to configure
# for it to work — but the link is deliberately short-lived: following it sets a
# new password with no further authentication, so it is a full
# account-takeover credential rather than a mere proof of address.
# How long a reset link stays valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=60
# Minimum seconds between two reset emails for one account. Prevents the
# endpoint from being used as a mail-bomb against a third party's inbox.
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Transactional SMS + phone verification (opt-in from the settings page)
# ---------------------------------------------------------------------------
# Phone verification is OPT-IN and never gates sign-in — email is the account
# recovery channel, a phone number is not. There is deliberately no
# PHONE_VERIFICATION_REQUIRED setting.

# auto | console | twilio
#   auto    (default) Twilio when TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN +
#           TWILIO_FROM_NUMBER are all set, otherwise console.
#   twilio  Twilio Programmable Messaging (requires all three settings below).
#   console Logs the code instead of sending it. Development only.
# Naming a transport whose credentials are incomplete is a startup error;
# `auto` never is. The boot log always names the resolved transport.
SMS_BACKEND=auto

# --- Twilio (SMS_BACKEND=twilio, or auto + all three) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own or a Messaging Service sender, in E.164 (e.g.
# +14155552671). Omitting it is the most common cause of a 400 from Twilio.
TWILIO_FROM_NUMBER=
SMS_HTTP_TIMEOUT_SECONDS=15

# How long a verification code stays valid. Long enough to survive carrier
# delivery latency, short enough to bound a leaked message.
PHONE_VERIFICATION_TTL_MINUTES=10
# Minimum seconds between two codes for one account. Each message costs money,
# so this is both an anti-abuse and a cost control. It is enforced silently:
# a throttled resend still answers 202 and sends nothing.
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Failed guesses a code tolerates before it is burned. A 6-digit code has ~20
# bits of entropy, so this ceiling is the only defence against online guessing.
PHONE_VERIFICATION_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# AI assistant ("Transform AI")
# ---------------------------------------------------------------------------
# A chat assistant embedded in the app. It answers questions about the user's
# own files and can act on them (summarise a document, recommend or start a
# conversion) through tools that reuse the regular file/conversion services, so
# ownership rules and quotas apply exactly as they do elsewhere.

# auto | openai | echo
#   auto    (default) openai when AI_API_KEY is set, otherwise echo.
#   openai  Any OpenAI-compatible chat-completions API (see AI_BASE_URL).
#   echo    No network at all. A local rule engine that handles the obvious
#           phrasings and otherwise explains that no real model is configured.
#           This is why the feature works with no API key: development and tests
#           need no provider, no egress and no cost, and the output is
#           deterministic. It answers from a fixed script, not from a model —
#           set AI_API_KEY for real answers.
# Naming a backend whose credentials are missing is a startup error; `auto`
# never is, and `echo` is always accepted. The boot log names the resolved one.
AI_BACKEND=auto

# --- OpenAI-compatible provider (AI_BACKEND=openai, or auto + AI_API_KEY) ---
# Any endpoint that speaks `POST /chat/completions` in the OpenAI wire format:
# OpenAI, Azure OpenAI, xAI (Grok), Groq, OpenRouter, Together, vLLM, Ollama,
# LM Studio.
#
# Two easily-confused providers — the API key's prefix tells them apart, and
# they use different URLs:
#   Groq (fast hosted open models)   https://api.groq.com/openai/v1   keys gsk_…
#   xAI  (Grok)                      https://api.x.ai/v1              keys xai-…
AI_API_KEY=
# Base URL WITHOUT a trailing slash and WITHOUT `/chat/completions`.
#   Groq:            https://api.groq.com/openai/v1
#   xAI (Grok):      https://api.x.ai/v1
#   OpenAI:          https://api.openai.com/v1
#   OpenRouter:      https://openrouter.ai/api/v1
#   Ollama (local):  http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
# The model MUST support tool calling: the assistant is tool-driven, so a model
# without it cannot list files, summarise a document, or start a conversion.
#   Groq:            openai/gpt-oss-120b (or openai/gpt-oss-20b, qwen/qwen3.8-27b)
#   xAI (Grok):      grok-4 (or grok-4-fast, grok-3)
#   OpenAI:          gpt-4o-mini
AI_MODEL=gpt-4o-mini

# Per-plan model overrides. The server maps a plan to a model LEVEL and then a
# level to a model id here, so a better plan can be served a better model:
#
#   Plan                Level       Setting
#   FREE (and GUEST)    standard    AI_MODEL_STANDARD
#   PRO / PREMIUM       advanced    AI_MODEL_ADVANCED
#   PRO_PLUS/ENTERPRISE priority    AI_MODEL_PRIORITY
#
# A BLANK value falls back to AI_MODEL — leave all three blank to serve one
# model to every plan (the default, and what an existing deployment already
# does). Each must support tool calling, exactly like AI_MODEL above.
AI_MODEL_STANDARD=
AI_MODEL_ADVANCED=
AI_MODEL_PRIORITY=

# Generation parameters. The temperature is deliberately low: the assistant's
# job is to pick the right tool with the right arguments, not to be creative.
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT_SECONDS=60

# Hard ceiling on tool round-trips per turn, and how many stored messages are
# replayed as chat history. Both bound prompt cost and request duration.
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_HISTORY_MESSAGES=20

# Document-reading limits for the assistant's file tools: the byte budget
# refuses a huge upload before it is read, the character budget bounds the
# prompt actually sent to the model.
AI_SUMMARY_MAX_INPUT_CHARS=48000
AI_MAX_DOCUMENT_BYTES=10485760

# Worker Configuration
WORKER_CONSUMER_GROUP=conversion-workers
WORKER_BATCH_SIZE=10
WORKER_CONVERSION_TIMEOUT=600

# Cleanup Worker (guest data retention)
CLEANUP_INTERVAL_SECONDS=21600
GUEST_JOB_RETENTION_HOURS=24
GUEST_FILE_RETENTION_HOURS=24
TEMP_FILE_RETENTION_HOURS=1
JOB_ARCHIVE_AFTER_DAYS=30
