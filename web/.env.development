# Local development defaults.
#
# The Vite dev server proxies `/api` to http://localhost:8000 (see
# vite.config.ts), so requests stay same-origin during development and no
# backend CORS configuration is required.
VITE_API_BASE_URL=/api

# Stripe publishable key. Setting it here turns on the in-app checkout
# (/app/checkout) locally. Leave it empty/unset to keep using Stripe's hosted
# page. See web/.env.example for the full explanation.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
